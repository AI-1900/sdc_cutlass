        <mxCell id="epi" parent="1" vertex="1" value="Epilogue Builder&#xA;FP32 线性组合 → CollectiveEpilogue&#xA;SharedStorage 用于主循环 SMEM 预算" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#17283D;align=center;verticalAlign=middle;rounded=0;fillColor=#E8F0FE;strokeColor=#9AABBE;">
