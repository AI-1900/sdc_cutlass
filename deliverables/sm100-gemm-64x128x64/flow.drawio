        </mxCell>
        <mxCell id="kernel" parent="1" vertex="1" value="GemmUniversal → Adapter&#xA;问题形状 (M,N,K,L)&#xA;TestAll 提供运行时尺寸与参数" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#17283D;align=center;verticalAlign=middle;rounded=0;fillColor=#E8F0FE;strokeColor=#9AABBE;">
