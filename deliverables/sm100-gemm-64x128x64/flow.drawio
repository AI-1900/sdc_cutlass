        </mxCell>
        <mxCell id="main" parent="1" vertex="1" value="Mainloop Builder&#xA;FP16 A/B + FP32 Acc + Auto&#xA;64×128×64，cluster 1×4×1" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#17283D;align=center;verticalAlign=middle;rounded=0;fillColor=#E8F0FE;strokeColor=#9AABBE;">
