  <diagram id="04-sdc200-porting" name="04-sdc200-porting">
    <mxGraphModel dx="1800" dy="1440" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1440">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SDC200 适配地图与验收顺序" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#172e47;fillColor=#edf1f5;strokeColor=#64758b;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="“对标 SM100”不等于 descriptor、TMEM、cluster、CLC 或 CUDA launch ABI 兼容" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#172e47;fillColor=#edf1f5;strokeColor=#64758b;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="85" width="1740" height="58" as="geometry" />
        </mxCell>
        <mxCell id="reuse" value="上层优先复用：GEMM 数学语义、ProblemShape、CuTe Layout/Tensor、Atom 框架、公共 Builder/Kernel/Adapter 签名&#10;测试组织、CPU reference 与比较工具尽量保留；host/device 注解、数据类型与 runtime 依赖仍需审查。" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#172e47;fillColor=#e7f5ef;strokeColor=#26806b;" vertex="1" parent="1">
          <mxGeometry x="30" y="170" width="1740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="compose" value="组合层：新增 SDC 策略与实现&#10;Mainloop / Epilogue Builder&#10;DispatchPolicy / Kernel 特化&#10;SMEM/TMEM 资源和 warp 分工" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#172e47;fillColor=#eaf2ff;strokeColor=#3b72b7;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="540" height="205" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="协议层：必须确认等价语义&#10;Pipeline acquire/commit/wait/release&#10;TMA/UMMA completion 与 fence&#10;TMEM 生命周期 / cluster scope" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#172e47;fillColor=#f0eafa;strokeColor=#8060af;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="540" height="205" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="运行时：替换或证明兼容&#10;参数 ABI / descriptor encoder&#10;launch / cluster / memory / stream&#10;硬件查询 / 错误 / 同步" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#172e47;fillColor=#fff2df;strokeColor=#c58428;" vertex="1" parent="1">
          <mxGeometry x="1230" y="390" width="540" height="205" as="geometry" />
        </mxCell>
        <mxCell id="isa" value="底层必须逐项闭环：MMA Operation + Traits + SMEM/instruction descriptor + TMEM allocator / T2R&#10;TMA copy / TensorMap + barrier / fence + election / cluster + scheduler CLC 或软件替代" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#172e47;fillColor=#fceaea;strokeColor=#b94c50;" vertex="1" parent="1">
          <mxGeometry x="30" y="680" width="1740" height="145" as="geometry" />
        </mxCell>
        <mxCell id="existing" value="已见：SDC200_MMA_F16BF16_SS::fma → __sdc_uten_mma_bf16；SDC descriptor union。&#10;仍待验收：FP16/BF16 模式、编码、完成事件；cluster_sdc200.hpp 仍含 NVIDIA election/cluster PTX。" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#172e47;fillColor=#edf1f5;strokeColor=#64758b;" vertex="1" parent="1">
          <mxGeometry x="30" y="895" width="1740" height="130" as="geometry" />
        </mxCell>
