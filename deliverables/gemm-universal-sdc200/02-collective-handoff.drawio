        <mxCell id="edge2" value="" style="endArrow=block;html=0;strokeWidth=2;strokeColor=#60748a;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#60748a;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="mma" target="acc">
