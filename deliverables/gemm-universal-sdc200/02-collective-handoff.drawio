        <mxCell id="edge5" value="" style="endArrow=block;html=0;strokeWidth=2;strokeColor=#60748a;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#60748a;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="cload" target="cwait">
          <mxGeometry relative="1" as="geometry" />
